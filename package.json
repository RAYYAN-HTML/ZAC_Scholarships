{
	"name": "scholarship-portal",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --host 0.0.0.0",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "tsx --test tests/core.test.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"admin:create": "tsx scripts/create-admin.ts",
		"research:import": "tsx scripts/import-research.ts",
		"research:import-pasted": "tsx scripts/import-pasted-research.ts"
	},
	"dependencies": {
		"@lucide/svelte": "^1.73.0",
		"drizzle-orm": "^0.44.7",
		"mysql2": "^3.15.3",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "5.5.8",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"dotenv": "^16.6.1",
		"drizzle-kit": "^0.31.8",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.20.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	}
}
